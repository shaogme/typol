locale en;

message cli.help = "Usage:
  typol [--language en|zh-CN] [--format text|json] [--diagnostic-detail] --help
  typol [global options] schema check <schema.tschem>
  typol [global options] schema fmt [--check] <schema.tschem>
  typol [global options] config check --schema <schema.tschem> [--environment inherit|empty] <config.tconf>
  typol [global options] config export-ir --schema <schema.tschem> [--environment inherit|empty] [--pretty] [--reject-secrets] <config.tconf>
  typol [global options] config fmt --schema <schema.tschem> [--environment inherit|empty] [--check] <config.tconf>

Commands:
  schema check       Compile and check a schema and its imports
  schema fmt         Format a schema file in place
  config check       Validate configuration against a schema
  config export-ir   Load and validate configuration, then output typed JSON IR v1
  config fmt         Format a validated configuration file in place

Options:
  --language         Select English or Simplified Chinese (default: detected)
  --format           text (default) or versioned JSON diagnostics
  --diagnostic-detail Include internal diagnostic context in JSON output
  --environment      inherit (default) reads process environment; empty ignores it
  --pretty           Output IR with indentation
  --reject-secrets   Fail before writing IR if any value is marked secret
  --check            Check config fmt without writing the file
  --check            Check schema fmt without writing the file
  -h, --help         Show this help

Put global options before the command. --diagnostic-detail requires --format=json. Set TYPOL_LANG to select a language when --language is omitted.\n";
message cli.error_prefix = "Command line error: ";
message cli.diagnostic_prefix = "Typol diagnostic details:\n";
