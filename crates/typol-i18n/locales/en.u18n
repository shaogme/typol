locale en;

message cli.help = "Usage:
  typol [--language en|zh-CN] --help
  typol [--language en|zh-CN] schema check <schema.tschem>
  typol [--language en|zh-CN] schema fmt [--check] <schema.tschem>
  typol [--language en|zh-CN] config check --schema <schema.tschem> [--environment inherit|empty] <config.tconf>
  typol [--language en|zh-CN] config export-ir --schema <schema.tschem> [--environment inherit|empty] [--pretty] [--reject-secrets] <config.tconf>
  typol [--language en|zh-CN] config fmt --schema <schema.tschem> [--environment inherit|empty] [--check] <config.tconf>

Commands:
  schema check       Compile and check a schema and its imports
  schema fmt         Format a schema file in place
  config check       Validate configuration against a schema
  config export-ir   Load and validate configuration, then output typed JSON IR v1
  config fmt         Format a validated configuration file in place

Options:
  --language         Select English or Simplified Chinese (default: detected)
  --environment      inherit (default) reads process environment; empty ignores it
  --pretty           Output IR with indentation
  --reject-secrets   Fail before writing IR if any value is marked secret
  --check            Check config fmt without writing the file
  --check            Check schema fmt without writing the file
  -h, --help         Show this help

Use --language before the command. Set TYPOL_LANG to select a language when the option is omitted.\n";
message cli.error_prefix = "Command line error: ";
