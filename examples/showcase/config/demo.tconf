// 此文件只使用本 crate 的 application.tschem 与 network.tschem。
// 示例回退凭据仅用于演示，不适合作为真实部署的密钥。
{
    service_name: env("SHOWCASE_SERVICE_NAME", "typol-demo"),
    endpoint: {
        host: env("SHOWCASE_HOST", "127.0.0.1"),
        port: env("SHOWCASE_PORT", 8443),
    },
    protocol: .Https({
        certificate: "/etc/ssl/certs/demo.pem",
        private_key: env("SHOWCASE_PRIVATE_KEY", "example-only-private-key"),
        verify_peer: true,
    }),
    storage: .ObjectStore {
        bucket: "typol-showcase",
        access_token: env("SHOWCASE_STORAGE_TOKEN", "example-only-storage-token"),
        region: "us-east-1",
    },
    worker_pool: {
        min_threads: 2,
        max_threads: 8,
    },
    retry: {
        // attempts、backoff_ms 与 multiplier 使用 Schema 中声明的默认值。
    },
    labels: {
        "team": "platform",
        "tier": "demo",
    },
    peers: [
        { host: "10.0.0.11", port: 8443 },
        { host: "10.0.0.12", port: 8443 },
    ],
    features: ["metrics", "health"],
    // optional_note 缺省后自动成为 none。
}
